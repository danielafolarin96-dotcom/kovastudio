# Copy this file to .env.local and fill it in. Never commit .env.local.

# ---- Supabase (Dashboard > Project Settings > API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://uaqsisnoxbvxemtmrinf.supabase.co
# "Publishable key" (starts with sb_publishable_). The old "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dRKxMZgem2HO7pzDKs15fA_a0IP3aFG
# "Secret key" (starts with sb_secret_). The old "service_role" key also works. SERVER ONLY.
SUPABASE_SECRET_KEY=

# ---- AI provider for Lucy 2.5: "fal" (card only) or "decart" (direct, needs ID check) ----
AI_PROVIDER=fal
# fal.ai > Dashboard > Keys. SERVER ONLY.
FAL_KEY=
# Decart (https://platform.decart.ai > API keys). Only needed when AI_PROVIDER=decart.
DECART_API_KEY=

# ---- Paystack (naira checkout on /account#buy) ----
# Paystack Dashboard > Settings > API Keys & Webhooks. Test key starts with sk_test_. SERVER ONLY.
PAYSTACK_SECRET_KEY=

# ---- Your site ----
# The address people open. Locally: http://localhost:3000. Live: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sites allowed to start sessions (comma separated). Usually the same as NEXT_PUBLIC_SITE_URL.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Admins: no watermark, no time limits, access to /admin ----
ADMIN_EMAILS=afolarindaniel96@gmail.com,ogunbowaleafolarindaniel96@gmail.com

# ---- Optional ----
# Longest single session, in seconds (Decart allows up to 3500 per token).
MAX_FREE_SESSION_SECONDS=120
MAX_PAID_SESSION_SECONDS=900
MAX_ADMIN_SESSION_SECONDS=3500
# Naira per dollar, used for AI cost in naira on /admin and /admin/finance. Update when the rate moves.
NAIRA_PER_DOLLAR=1330
# Shown to users who need more time.
NEXT_PUBLIC_SUPPORT_EMAIL=
